# ==============================================================================
# FinFlow - Environment Configuration (.env)
# ==============================================================================

# Application Settings
PROJECT_NAME="FinFlow API"
ENVIRONMENT=production
DEBUG=false

# Database Configuration (PostgreSQL 16)
# Format: postgresql+asyncpg://<username>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql+asyncpg://finflow:secret@localhost:5432/finflow_db

# PostgreSQL Container Credentials (used by docker-compose)
POSTGRES_USER=finflow
POSTGRES_PASSWORD=secret
POSTGRES_DB=finflow_db
POSTGRES_PORT=5432

# Security & Authentication
# IMPORTANT: Generate a strong secret in production: `openssl rand -hex 32`
JWT_SECRET=super-secret-jwt-key-change-this-in-production-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Currency Configuration
DEFAULT_CURRENCY_SYMBOL=k-Toman

# CORS Configuration (comma-separated list of allowed origins)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5173,http://localhost:8000

# Frontend Port (defaults to 3001 if 3000 is occupied)
FRONTEND_PORT=3001
